---
import About from "../components/About.astro";
import Base from "../layouts/Base.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Stack from "../components/Stack.astro";
import Statusline from "../components/Statusline.astro";
import Work from "../components/Work.astro";

// Person + WebSite structured data. The @id node is referenced by the
// TechArticle blocks on each case study page, so it must stay stable.
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Person",
			"@id": "https://itzmaniss.dev/#person",
			name: "Manish Balasubramanian",
			alternateName: "itzmaniss",
			url: "https://itzmaniss.dev/",
			jobTitle: "Software Engineer",
			worksFor: {
				"@type": "Organization",
				name: "MyRideSG",
				url: "https://myridesg.com",
			},
			homeLocation: {
				"@type": "Place",
				name: "Singapore",
			},
			sameAs: [
				"https://linkedin.com/in/itzmaniss",
				"https://github.com/itzmaniss",
			],
		},
		{
			"@type": "WebSite",
			name: "itzmaniss.dev",
			url: "https://itzmaniss.dev/",
			author: { "@id": "https://itzmaniss.dev/#person" },
		},
	],
};
---

<Base
	title="Manish Balasubramanian (itzmaniss) | Software Engineer"
	description="Manish Balasubramanian (itzmaniss) is a software engineer and computer science student in Singapore, founding engineer at MyRideSG. Available for contract work."
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(jsonLd)}
		/>
	</Fragment>
	<Header />
	<main id="main">
		<Hero />
		<About />
		<Services />
		<Work />
		<Stack />
		<Contact />
	</main>
	<Footer />
	<Statusline />
</Base>
