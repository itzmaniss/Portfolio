---
import { navLinks } from "../data/site";
---

<header
	class="fixed top-0 inset-x-0 z-50 border-b border-line bg-ink/80 backdrop-blur-md"
>
	<div
		class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8"
	>
		<a
			href="#top"
			class="flex items-center gap-2.5 text-accent"
			aria-label="Manish, back to top"
		>
			<svg
				viewBox="0 0 64 64"
				class="h-8 w-8"
				aria-hidden="true"
				focusable="false"
			>
				<rect
					x="4"
					y="4"
					width="56"
					height="56"
					rx="10"
					fill="#34d399"
					fill-opacity="0.08"
					stroke="#34d399"
					stroke-width="2"></rect>
				<path
					d="M17 30 L24 24 L32 32 L40 24 L47 30 L47 42 L40 42 L40 34 L32 42 L24 34 L24 42 L17 42 Z"
					fill="#34d399"></path>
			</svg>
			<span
				class="hidden text-sm font-medium tracking-tight text-text sm:block"
				>manish</span
			>
		</a>

		<!-- Desktop nav; the scroll spy in script.js drives aria-current. -->
		<nav class="hidden items-center gap-8 text-sm md:flex" aria-label="Main">
			{navLinks.map((link) => (
				<a href={link.href} data-nav class="nav-link">
					{link.label}
				</a>
			))}
			<a
				href="#contact"
				class="border border-line-bright px-4 py-1.5 text-text transition-colors duration-200 hover:border-accent hover:text-accent"
				>start a project</a
			>
		</nav>

		<!-- Mobile toggle -->
		<button
			id="menu-toggle"
			type="button"
			class="flex h-9 w-9 items-center justify-center text-accent md:hidden"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Open menu"
		>
			<svg
				class="h-5 w-5"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<path
					id="menu-icon-open"
					stroke-linecap="round"
					d="M4 7h16M4 12h16M4 17h16"></path>
				<path
					id="menu-icon-close"
					class="hidden"
					stroke-linecap="round"
					d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</button>
	</div>

	<!-- Mobile menu -->
	<nav
		id="mobile-menu"
		class="hidden border-t border-line bg-ink-2 md:hidden"
		aria-label="Mobile"
	>
		<div class="flex flex-col px-5 py-3 text-sm">
			{navLinks.map((link) => (
				<a href={link.href} class="mobile-link">{link.label}</a>
			))}
			<a href="#contact" class="mobile-link text-accent">start a project</a>
		</div>
	</nav>
</header>
