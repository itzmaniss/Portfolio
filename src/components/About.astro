---
import SectionHeader from "./SectionHeader.astro";

// The status row gets the accent dot; the rest are plain term/value pairs.
const rows: { term: string; value: string; dot?: boolean }[] = [
	{ term: "based", value: "Singapore, UTC+8" },
	{ term: "writing code", value: "since 2021" },
	{ term: "focus", value: "backend, automation" },
	{ term: "currently", value: "founding engineer @ MyRideSG" },
	{ term: "status", value: "open to work", dot: true },
	{ term: "reply time", value: "within 24 hours" },
];
---

<section
	id="about"
	class="mx-auto max-w-6xl px-5 py-24 sm:px-8"
	aria-labelledby="about-heading"
>
	<h2 id="about-heading" class="sr-only">About</h2>
	<SectionHeader command="cat about.md" />

	<div class="mt-10 grid gap-12 md:grid-cols-12 md:gap-16">
		<div class="md:col-span-7" data-reveal>
			<p class="text-pretty text-lg leading-relaxed text-text sm:text-xl">
				I've been writing code since 2021. It started with
				scrapers, turned into  Discord bots, then data tools,
				then the services running underneath them.
			</p>
			<p class="mt-6 text-pretty leading-relaxed text-muted">
				These days most of my time goes into <a href="https://myridesg.com" target="_blank" rel="noopener noreferrer" class="text-text underline decoration-accent/60 underline-offset-4 transition-colors duration-200 hover:text-accent">MyRideSG</a>, where I'm a founding engineer. I own the partners app and the website end to end, and I work closely with my partner on the rider app: product input, feedback and reviews.
			</p>
			<p class="mt-6 text-pretty leading-relaxed text-muted">
				Most of what I build now is backend work and the tooling that sits under it: Discord bots that stay up, market data pipelines, a VS Code extension. Outside of that, I spend time rebuilding things that already exist, like a concurrent job queue or a TCP server from scratch, not because I need them, but because I'd rather understand how something works than just trust that it does.
				I'm a computer science student in Singapore, taking on contract work alongside my degree. If you've got something that needs building, or something that already exists and keeps breaking, I'd like to hear about it.
			</p>
		</div>

		<div class="md:col-span-5" data-reveal>
			<dl class="divide-y divide-line border-y border-line">
				{rows.map((row) => (
					<div class="flex justify-between gap-4 py-3.5">
						<dt class="text-sm text-muted">{row.term}</dt>
						{row.dot ? (
							<dd class="flex items-center gap-2 text-sm text-accent">
								<span
									class="h-1.5 w-1.5 rounded-full bg-accent"
									aria-hidden="true"></span>
								{row.value}
							</dd>
						) : (
							<dd class="text-sm text-text">{row.value}</dd>
						)}
					</div>
				))}
			</dl>
		</div>
	</div>
</section>
