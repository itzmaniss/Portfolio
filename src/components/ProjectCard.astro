---
import type { Project } from "../data/site";

interface Props {
	project: Project;
}

const { project } = Astro.props;
// A case-study slug makes the card an internal link; internal links never
// open a new tab. Everything else keeps its external behaviour.
const href = project.caseStudy ? `/work/${project.caseStudy}/` : project.href;
const external = !project.caseStudy;
---

<a
	href={href}
	target={external ? "_blank" : undefined}
	rel={external ? "noopener noreferrer" : undefined}
	class="group relative block border-t border-line px-4 py-8 transition-colors duration-300 before:absolute before:inset-y-[-1px] before:left-0 before:w-0.5 before:origin-top before:scale-y-0 before:bg-accent before:transition-transform before:duration-300 hover:bg-surface/50 hover:before:scale-y-100 sm:px-6"
>
	<div class="flex flex-col gap-4 md:flex-row md:items-baseline md:gap-10">
		<div class="md:w-1/3">
			<h3
				class="text-xl font-medium tracking-tight text-text transition-colors duration-200 group-hover:text-accent"
			>
				{project.title}
			</h3>
			<p class="mt-2 text-xs text-dim">{project.meta}</p>
		</div>
		<div class="md:flex-1">
			<p class="text-sm leading-relaxed text-muted">
				{project.description}
			</p>
			<div class="mt-4 flex flex-wrap gap-2">
				{project.tags.map((tag) => (
					<span class="border border-line px-2.5 py-1 text-xs text-muted"
						>{tag}</span
					>
				))}
			</div>
		</div>
		<span
			class="text-muted transition-transform duration-300 group-hover:translate-x-1 group-hover:text-accent"
			aria-hidden="true"
			>&rarr;</span
		>
	</div>
</a>
