<section
	class="relative flex min-h-[100svh] items-center overflow-hidden pt-16"
>
	<!-- Terminal cell matrix, fading out downward -->
	<div
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 opacity-[0.55] [mask-image:linear-gradient(to_bottom,black_0%,transparent_85%)] [background-image:linear-gradient(to_right,#1f2b28_1px,transparent_1px),linear-gradient(to_bottom,#1f2b28_1px,transparent_1px)] [background-size:72px_72px]"
	></div>
	<div
		aria-hidden="true"
		class="pointer-events-none absolute -left-40 top-1/4 h-[32rem] w-[32rem] rounded-full bg-accent/[0.07] blur-[100px]"
	></div>

	<div class="relative mx-auto w-full max-w-6xl px-5 py-20 sm:px-8">
		<p class="animate-boot text-sm text-muted [animation-delay:0ms]">
			<span class="text-accent">~/manish $</span> whoami<span
				class="ml-1 inline-block h-[1.05em] w-[0.55em] translate-y-[0.15em] animate-blink bg-accent"
				aria-hidden="true"></span>
		</p>

		<!-- The h1 accessible name is "Manish Balasubramanian": the casing is
		     CSS only, so no aria-hidden splitting. Both lines are sized in em
		     off the same clamp, so they scale together and the 15-character
		     surname never overflows its container. -->
		<h1
			aria-label="Manish Balasubramanian"
			class="animate-boot mt-6 text-[clamp(2.75rem,11vw,8.5rem)] font-semibold uppercase leading-[0.9] tracking-[-0.06em] text-text [animation-delay:120ms]"
		>
			<span class="block">Manish</span>
			<span class="block text-[0.4em]">Balasubramanian</span>
		</h1>

		<div class="animate-boot mt-8 flex items-center gap-4 [animation-delay:240ms]">
			<span class="h-px w-12 bg-accent"></span>
			<p class="text-base text-accent sm:text-lg">
				Backend &amp; automation developer
			</p>
		</div>

		<p
			class="animate-boot mt-8 max-w-2xl text-pretty text-base leading-relaxed text-muted sm:text-lg [animation-delay:340ms]"
		>
			I build the parts your users never see: APIs, bots, scrapers, and the scheduled jobs on permanent night shift, keeping everything running. Mostly in Python, TypeScript, and Go. Right now I'm a founding engineer at <a href="https://myridesg.com" target="_blank" rel="noopener noreferrer" class="text-text underline decoration-accent/60 underline-offset-4 transition-colors duration-200 hover:text-accent">MyRideSG</a>, where I build the partners app and the website for the app Singapore's riders run their bikes on.
	</p>

		<div
			class="animate-boot mt-10 flex flex-col gap-3 sm:flex-row sm:items-center [animation-delay:440ms]"
		>
			<a
				href="#contact"
				class="group inline-flex items-center justify-center gap-2.5 bg-accent px-6 py-3.5 text-sm font-semibold text-ink transition-all duration-200 hover:bg-accent-bright hover:shadow-[0_8px_24px_-10px_var(--color-accent)]"
			>
				Start a project
				<span
					class="transition-transform duration-200 group-hover:translate-x-1"
					aria-hidden="true"
					>&rarr;</span
				>
			</a>
			<a
				href="#work"
				class="inline-flex items-center justify-center gap-2.5 border border-line-bright px-6 py-3.5 text-sm text-text transition-all duration-200 hover:border-accent hover:text-accent"
			>
				See what I've built
			</a>
		</div>

		<p
			class="animate-boot mt-12 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted [animation-delay:540ms]"
		>
			<span class="relative flex h-2 w-2" aria-hidden="true">
				<span
					class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-70"></span>
				<span
					class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
			</span>
			<span class="text-text">Available for contract work</span>
			<span class="text-dim">·</span>
			<span>Singapore, UTC+8</span>
		</p>
	</div>
</section>
