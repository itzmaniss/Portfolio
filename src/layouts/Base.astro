---
import "../styles/global.css";
// Self-hosted IBM Plex Mono, latin subset only, the four weights in use.
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-700.css";
// The two fonts above the fold need: body is 400, the hero h1 is 600.
// ?url resolves to the same hashed dist path the @font-face rules use,
// so preload and CSS fetch each file exactly once.
import fontRegularUrl from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import fontSemiBoldUrl from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url";

interface Props {
	title: string;
	description: string;
	/** Absolute canonical URL. Defaults to the current pathname on the site. */
	canonical?: string;
	/** "article" on case study pages, "website" everywhere else. */
	ogType?: "website" | "article";
}

const { title, description, canonical, ogType = "website" } = Astro.props;

// Every page on the site is served directory-style (/work/slug/), which is
// the form Cloudflare Pages answers 200 without a redirect, so the default
// canonical pathname is normalized to that same trailing-slash form.
const pathname = Astro.url.pathname.endsWith("/")
	? Astro.url.pathname
	: Astro.url.pathname + "/";
const canonicalHref = canonical ?? new URL(pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#0B0F0E" />
		<link rel="canonical" href={canonicalHref} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalHref} />
		<meta property="og:site_name" content="itzmaniss.dev" />
		<meta name="twitter:card" content="summary" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" type="image/png" href="/favicon.png" />

		<link
			rel="preload"
			as="font"
			type="font/woff2"
			crossorigin
			href={fontRegularUrl}
		/>
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			crossorigin
			href={fontSemiBoldUrl}
		/>

		<!-- Structured data and per-page head extras. -->
		<slot name="head" />

		<!-- Set before paint so reveal styles never flash. -->
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
		<script>
			import "../scripts/script.js";
		</script>
	</head>
	<body id="top" class="bg-ink text-text antialiased pb-8">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:bg-accent focus:text-ink focus:px-4 focus:py-2 focus:font-semibold"
			>Skip to content</a
		>

		<slot />
	</body>
</html>
